{
  "manifest_version": 3,
  "name": "GomHD Auto Captcha",
  "version": "1.1",
  "description": "Tự động phát hiện và giải mã captcha trên các trang Thuế.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://127.0.0.1:28374/*",
    "https://dichvucong.gdt.gov.vn/*",
    "https://thuedientu.gdt.gov.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
