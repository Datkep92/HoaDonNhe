PORT=8080
# Deployed Google Apps Script Web App URL (ends in /exec)
GAS_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# Same long random secret saved in Apps Script Properties as GATEWAY_SHARED_SECRET
GAS_SHARED_SECRET=replace-with-at-least-32-random-characters
# At least 32 random characters. Never share or embed this in the desktop app.
TOKEN_SECRET=replace-with-another-at-least-32-random-characters
# Phase 3 (leave unset until Firebase is ready)
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
# One-line JSON for Firebase service account, stored only in your host secret manager
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# Phase 4 (Telegram supergroup must have Topics enabled; bot must be an admin)
TELEGRAM_BOT_TOKEN=123456:replace-with-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# Random secret used when registering the Telegram webhook, at least 32 characters
TELEGRAM_WEBHOOK_SECRET=replace-with-a-third-at-least-32-random-characters
# Only needed to run `npm run telegram:webhook` after Gateway deployment
PUBLIC_GATEWAY_URL=https://your-support-gateway.example.com
